# Secrets and config for the telecloud-app container only. Loaded via compose.yml's
# `env_file:` under the telecloud-app service. See SECURITY_NOTES.md's "Environment
# File Architecture" section for how this fits with .env.example and .env.db.example.

# ── Database ──────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Encryption ────────────────────────────────────────────────────────────────
# Used to encrypt StringSession and API credentials at rest
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Secret for signing JWTs — use a long random string
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Local dev: http://localhost:5173,http://localhost:5001
# Production: https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5001

# ── Telegram ──────────────────────────────────────────────────────────────────
# Max number of Telegram messages to scan when building the file list (0 = unlimited)
MAX_SCAN_MESSAGES=2000

# ── Uploads ───────────────────────────────────────────────────────────────────
# Cap for single-shot /upload before a file must go through chunked sessions instead
MAX_UPLOAD_SIZE_MB=500
# File size at/above which uploads use the durable, resumable session flow
RESUMABLE_UPLOAD_THRESHOLD_MB=10
# How long an abandoned upload session is kept before being reaped (seconds)
UPLOAD_SESSION_EXPIRE_SECONDS=604800

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# LOG_TO_FILE intentionally left unset — Docker deployments log to stdout only (see
# docker/backend/Dockerfile's PYTHONUNBUFFERED=1) and rely on `docker logs`/journald
# rather than an in-container rotating file handler.
