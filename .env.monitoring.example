# ntfy.sh notification topic — see docs/MONITORING.md
#
# cp .env.monitoring.example .env.monitoring, fill in a real value, chmod 600.
# Never commit the real .env.monitoring file.
#
# ntfy.sh's free/public server has no built-in access control -- anyone who
# knows this topic name can read (or publish fake alerts to) it. Generate a
# long random value and treat it as a secret, same as every other credential
# in this project:
#   openssl rand -hex 24

NTFY_TOPIC=generate-with-openssl-rand-hex-24
