# ── Database ──────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Encryption ────────────────────────────────────────────────────────────────
# Used to encrypt StringSession and API credentials at rest
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Secret for signing JWTs — use a long random string
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Local dev: http://localhost:5173,http://localhost:5001
# Production: https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5001

# ── Telegram ──────────────────────────────────────────────────────────────────
# Max number of Telegram messages to scan when building the file list (0 = unlimited)
MAX_SCAN_MESSAGES=2000

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
