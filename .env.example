# TeleCloud environment variables
# Copy to .env and fill in values

# Required — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# Set to true when running behind HTTPS (enables Secure flag on cookies)
SECURE_COOKIES=false

# Max number of Telegram messages to scan when building the file list
MAX_SCAN_MESSAGES=2000

# Server bind (default: localhost only)
HOST=127.0.0.1
PORT=5001
