# Restic + Backblaze B2 backup credentials — see docs/BACKUP_POLICY.md
#
# cp .env.backup.example .env.backup, fill in real values, chmod 600.
# Never commit the real .env.backup file.
#
# CRITICAL: RESTIC_PASSWORD must ALSO be stored somewhere outside this
# machine (password manager, etc.) before this is considered set up. If this
# file (and any copy of it) is lost, every snapshot in the B2 bucket becomes
# permanently undecryptable — the offsite backup exists but is worthless.
# Generate it with: openssl rand -base64 32

AWS_ACCESS_KEY_ID=your-b2-application-key-id
AWS_SECRET_ACCESS_KEY=your-b2-application-key
RESTIC_REPOSITORY=s3:https://s3.<region>.backblazeb2.com/<bucket-name>/telecloud
RESTIC_PASSWORD=generate-with-openssl-rand-base64-32-store-a-copy-outside-the-vm
