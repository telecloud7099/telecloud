# Secrets and config for the postgres container only. Loaded via compose.yml's
# `env_file:` under the postgres service. Unused while DATABASE_URL in .env.app
# points at Neon (Phase A) — defined now so the compose stack's shape doesn't
# change later, only DATABASE_URL needs to flip at the Phase 5B cutover.
#
# POSTGRES_USER is also read inside the postgres container's own healthcheck
# shell (compose.yml uses "$$POSTGRES_USER", escaped from Compose's file-level
# substitution) — it does NOT need to be duplicated into the project-root .env.

POSTGRES_USER=telecloud
POSTGRES_PASSWORD=
POSTGRES_DB=telecloud
